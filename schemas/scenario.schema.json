{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tashtit/marketplace/schemas/scenario.schema.json",
  "title": "Tashtit acceptance scenario",
  "description": "Behavioral acceptance scenario for a Tashtit plugin. Provider hosts do not read this file; it is the repository's behavioral contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "platforms", "prompt", "setup", "expected", "must_not"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Globally unique lowercase kebab-case identifier."
    },
    "type": {
      "type": "string",
      "enum": ["positive", "failure", "unsafe"]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["claude-code", "codex", "cursor", "github-copilot"]
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "setup": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "must_not": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
